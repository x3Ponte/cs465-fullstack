<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{!-- the header partial gets dropped in here by handlebars --}}
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>Travel</h1>
                            <ul id="sites">
                                {{!-- loops over every trip the controller passed in from trips.json --}}
                                {{#each trips}}
                                <li>
                                    <a href="/travel"><img src="/images/{{this.image}}" alt="Img"></a>
                                    <h2><a href="/travel">{{this.name}}</a></h2>
                                    {{!-- triple braces so the p tags in the description render as html instead of showing up as text --}}
                                    {{{this.description}}}
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{!-- same thing for the footer partial --}}
        {{> footer }}
    </div>
</body>
</html>